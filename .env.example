# Colon-separated on macOS/Linux; semicolon-separated on Windows.
CITYJSON_MCP_ALLOWED_ROOTS=/absolute/path/to/cityjson/data
CITYJSON_MCP_WORKSPACE=/absolute/path/to/cityjson/data/.cityjson-mcp-workspace
CITYJSON_MCP_COMMAND_TIMEOUT_MS=120000

# Optional executable overrides.
CJIO_BIN=cjio
CJVAL_BIN=cjval
VAL3DITY_BIN=val3dity
CITYGML_TOOLS_BIN=citygml-tools
CJDB_BIN=cjdb

# cjdb/PostgreSQL password. Do not put passwords in MCP tool calls.
# PGPASSWORD=change-me
