# Configuration for the CityJSON MCP Toolbox. Copy this file to `.env` and edit the values as needed. The default values are suitable for local development.
CITYJSON_MCP_INPUT=./input
CITYJSON_MCP_WORKSPACE=./.cityjson-mcp-workspace
CITYJSON_MCP_COMMAND_TIMEOUT_MS=120000

# Model configuration. The default is Gemini 3.7 Flash via the OpenAI API. 
# You can also use Ollama or other providers.
MODEL_PROVIDER=openai
MODEL_NAME=gemini-3.7-flash
MODEL_API_KEY=your-api-key
MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MODEL_MAX_OUTPUT_TOKENS=4096
MODEL_TEMPERATURE=0.1

# Example for native Ollama while Datum runs in Docker:
# MODEL_PROVIDER=ollama
# MODEL_NAME=qwen3:8b
# MODEL_API_KEY=
# MODEL_BASE_URL=http://host.docker.internal:11434/v1

CHAT_HOST=127.0.0.1
CHAT_PORT=3000
CHAT_MAX_UPLOAD_BYTES=1073741824
CHAT_MAX_UPLOAD_FILES=5
CHAT_MAX_TOOL_ROUNDS=12
# Optional: Allow partial backends. If true, the chat will continue even if some backends fail. If false, the chat will stop on any backend failure.
# CHAT_ALLOW_PARTIAL_BACKENDS=true

# Optional executable overrides.
CJIO_BIN=cjio
CJVAL_BIN=cjval
VAL3DITY_BIN=val3dity
CITYGML_TOOLS_BIN=citygml-tools
CJDB_BIN=cjdb

# cjdb/PostgreSQL password. Do not put passwords in MCP tool calls.
# PGPASSWORD=change-me
