# Configuration for the CityJSON MCP Toolbox. Copy this file to `.env` and edit the values as needed. The default values are suitable for local development.
CITYJSON_MCP_INPUT=./input
CITYJSON_MCP_WORKSPACE=./.cityjson-mcp-workspace
CITYJSON_MCP_COMMAND_TIMEOUT_MS=120000

# Model configuration. OpenRouter's free router is the recommended free cloud
# starting point. Paid Gemini or DeepSeek models are the stronger options for
# reliable, demanding workflows. Datum supports OpenRouter, OpenAI-compatible,
# Anthropic, and local Ollama providers.
MODEL_PROVIDER=openrouter
MODEL_NAME=openrouter/free
MODEL_API_KEY=your-openrouter-api-key
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_MAX_OUTPUT_TOKENS=4096
MODEL_TEMPERATURE=0.1

# Bundled Ollama startup mode. When unset, `npm run chat` enables Ollama only
# when MODEL_PROVIDER=ollama. Set true to keep Ollama available alongside a
# cloud default, or false to force cloud-only startup.
# CHAT_ENABLE_OLLAMA=false

# OpenRouter cloud catalog. openrouter/free automatically selects an available
# free model compatible with the requested features and tools.
# MODEL_PROVIDER=openrouter
# MODEL_NAME=openrouter/free
# MODEL_API_KEY=your-openrouter-api-key
# MODEL_BASE_URL=https://openrouter.ai/api/v1

# OpenAI GPT Nano (cloud, metered API; not a free model)
# MODEL_PROVIDER=openai
# MODEL_NAME=gpt-5-nano
# MODEL_API_KEY=your-openai-api-key
# MODEL_BASE_URL=https://api.openai.com/v1

# Example for Ollama. `npm run chat` starts its Ollama companion automatically
# when MODEL_PROVIDER=ollama; the base URL overrides are normally unnecessary.
# MODEL_PROVIDER=ollama
# MODEL_NAME=qwen3:8b
# MODEL_API_KEY=
# MODEL_BASE_URL=http://ollama:11434/v1
# OLLAMA_BASE_URL=http://ollama:11434/v1
# Ollama context window in tokens: 8192 (lighter), 16384 (default), or 32768 (more memory)
# OLLAMA_CONTEXT_LENGTH=16384

CHAT_HOST=127.0.0.1
CHAT_PORT=3000
CHAT_MAX_UPLOAD_BYTES=1073741824
CHAT_MAX_UPLOAD_FILES=5
CHAT_MAX_TOOL_ROUNDS=12
# Optional: Allow partial backends. If true, the chat will continue even if some backends fail. If false, the chat will stop on any backend failure.
# CHAT_ALLOW_PARTIAL_BACKENDS=true

# Optional executable overrides.
CJIO_BIN=cjio
CJVAL_BIN=cjval
VAL3DITY_BIN=val3dity
CITYGML_TOOLS_BIN=citygml-tools
CJDB_BIN=cjdb

# cjdb/PostgreSQL password. Do not put passwords in MCP tool calls.
# PGPASSWORD=change-me
