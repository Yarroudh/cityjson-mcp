# Colon-separated on macOS/Linux; semicolon-separated on Windows. Relative
# defaults make the local chat runnable immediately; use absolute paths when
# configuring standalone clients or additional allowed roots.
CITYJSON_MCP_ALLOWED_ROOTS=.
CITYJSON_MCP_INPUT=./input
CITYJSON_MCP_WORKSPACE=./.cityjson-mcp-workspace
CITYJSON_MCP_COMMAND_TIMEOUT_MS=120000

# Optional default model for the chat application. Users can instead configure
# these settings from the model dialog. MODEL_PROVIDER selects the API style:
# `anthropic` Messages or OpenAI-compatible Chat Completions.
MODEL_PROVIDER=openai
MODEL_NAME=your-tool-capable-model-id
MODEL_API_KEY=your-api-key
MODEL_BASE_URL=https://api.deepseek.com
MODEL_MAX_OUTPUT_TOKENS=4096
MODEL_TEMPERATURE=0.1

CHAT_HOST=127.0.0.1
CHAT_PORT=3000
CHAT_MAX_UPLOAD_BYTES=1073741824
CHAT_MAX_UPLOAD_FILES=5
CHAT_MAX_TOOL_ROUNDS=12
# Host-only development normally refuses to start when backend executables are
# missing. Set this only when deliberately testing native inspection features.
# CHAT_ALLOW_PARTIAL_BACKENDS=true

# Optional executable overrides.
CJIO_BIN=cjio
CJVAL_BIN=cjval
VAL3DITY_BIN=val3dity
CITYGML_TOOLS_BIN=citygml-tools
CJDB_BIN=cjdb

# cjdb/PostgreSQL password. Do not put passwords in MCP tool calls.
# PGPASSWORD=change-me
