{
  "name": "cityjson-toolbox-mcp",
  "version": "0.1.0",
  "description": "MCP server for manipulating, validating, converting, querying and documenting CityJSON datasets.",
  "type": "module",
  "bin": {
    "cityjson-toolbox-mcp": "./src/index.mjs"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "chat": "docker compose -f docker/docker-compose.chat.yml up --build",
    "chat:host": "node src/web/server.mjs",
    "check": "node --check src/index.mjs && node scripts/check-all.mjs",
    "test": "node --test",
    "render:diagrams": "python3 scripts/render_diagrams.py",
    "doctor": "node scripts/doctor.mjs",
    "docker:build": "docker build -f docker/Dockerfile -t cityjson-mcp .",
    "docker:cache:val3dity": "docker build -f docker/Dockerfile --target val3dity-builder -t cityjson-mcp-val3dity-builder .",
    "docker:cache:cjval": "docker build -f docker/Dockerfile --target cjval-builder -t cityjson-mcp-cjval-builder .",
    "docker:doctor": "docker run --rm --entrypoint node cityjson-mcp /app/scripts/doctor.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "busboy": "^1.6.0",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "zod": "^4.0.0"
  },
  "keywords": [
    "mcp",
    "cityjson",
    "citygml",
    "cjio",
    "cjval",
    "val3dity",
    "cjdb",
    "3d-city-models"
  ],
  "license": "MIT"
}
